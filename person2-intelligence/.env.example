# ---- LLM (Muse Spark) ----
LLM_MODE=mock                  # mock | live
META_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3      # confirm the exact id in the Meta Model API dashboard
MUSE_REASONING_EFFORT=low      # empty this if the API rejects it (check_0 tells you)
LLM_TIMEOUT=25

# ---- SAM 3.1 (vision/detect) ----
SAM_MODE=mock                  # mock | live
SAM_ENDPOINT_URL=              # fill in once you have real SAM access — see intelligence/vision.py
SAM_API_KEY=
SAM_CONFIDENCE_THRESHOLD=0.5

# ---- Preferences ----
PREF_MODE=local                # local | backboard
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=        # check_0 creates one and prints the id
LOCAL_PREF_PATH=.prefs.json

# ---- Chat parsing ----
CHAT_WINDOW_DAYS=14
CHAT_DATE_ORDER=auto           # auto | MDY | DMY

# ---- Mock only ----
MOCK_ANALYSIS_SCENARIO=match   # match | mismatch
