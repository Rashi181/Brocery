# Both Muse and SAM use this key unless MUSE_API_KEY is set separately.
SAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SCENE_MODEL=gemini-3.1-flash-lite
LLM_MODE=live
SAM_MODE=live
SAM_ENDPOINT_URL=https://api.meta.ai/v1/responses
MUSE_MODEL=muse-spark-1.3
LLM_TIMEOUT=90
# Optional Backboard memory. Local durable JSON is the default.
PREF_MODE=local
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
